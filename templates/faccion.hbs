<form class="{{cssClass}} mrg mrg-hoja-f" autocomplete="off">

  <header class="mrg-cab-hoja mrg-cab-hoja--sin-retrato">
    <div class="mrg-cab-datos">
      <input class="mrg-nombre" type="text" name="name" value="{{actor.name}}" placeholder="Nombre de la facción" aria-label="Nombre">
      <div class="mrg-cab-chips">
        {{#each mr.bandos}}
        <button type="button" class="mrg-chipbtn {{#if sel}}mrg-sel{{/if}}" data-set="system.category" data-valor="{{v}}" aria-pressed="{{sel}}">{{t}}</button>
        {{/each}}
      </div>
    </div>
  </header>

  <section class="mrg-vitales" aria-label="Nivel de la facción">
    <div class="mrg-vital mrg-vital--estres">
      <div class="mrg-vital-t"><span class="mrg-etiqueta">Nivel</span><b>{{mr.nivel.valor}}/{{mr.nivel.max}}</b></div>
      <div class="mrg-pips" role="group" aria-label="Nivel">
        {{#each mr.nivel.pips}}<button type="button" class="mrg-pip" data-pip="system.tier.value" data-n="{{n}}" aria-pressed="{{on}}" aria-label="Nivel {{n}}"></button>{{/each}}
      </div>
    </div>
    <div class="mrg-vital">
      <button type="button" class="mrg-btn" data-fortuna="{{mr.nivel.valor}}" data-titulo="{{actor.name}}"><i class="fa-solid fa-dice"></i> Tirada de nivel <small>{{mr.nivel.valor}}d</small></button>
    </div>
  </section>

  <div class="mrg-cuerpo">
    <section class="mrg-panel">
      <h4 class="mrg-seccion">Relojes <small>proyectos de la facción</small></h4>
      <div class="mrg-relojes">
        {{#each mr.relojes}}
        <article class="mrg-objeto">
          <header><h5>Reloj {{k}}</h5>
            <label class="mrg-selector"><span class="mrg-etiqueta">Tamaño</span>
              <select data-select="system.clock{{k}}.max" data-tipo="n">{{#each opciones}}<option value="{{v}}" {{#if sel}}selected{{/if}}>{{t}}</option>{{/each}}</select></label>
          </header>
          {{#if activo}}
          <input type="text" name="system.clock{{k}}.text" value="{{texto}}" placeholder="¿Qué proyecto es?" aria-label="Proyecto del reloj {{k}}">
          <div class="mrg-pips" role="group" aria-label="Segmentos del reloj {{k}}">
            {{#each pips}}<button type="button" class="mrg-pip" data-pip="system.clock{{../k}}.value" data-n="{{n}}" aria-pressed="{{on}}" aria-label="Segmento {{n}}"></button>{{/each}}
          </div>
          <p class="mrg-nota">{{valor}} de {{max}} segmentos</p>
          {{else}}<p class="mrg-nota">Apagado: elige un tamaño para usarlo.</p>{{/if}}
        </article>
        {{/each}}
      </div>
      <div class="mrg-editor"><span class="mrg-etiqueta">Notas</span>{{editor notes target="system.description" button=true owner=owner editable=editable}}</div>
    </section>
  </div>
</form>
