<form class="{{cssClass}} mrg mrg-hoja-f {{#if mr.compacta}}mrg-compacta{{/if}} {{#if mr.evolucion}}mrg-evolucion{{/if}}" autocomplete="off">

  {{!-- Cabecera (las herramientas viven en la barra de la ventana) --}}
  <header class="mrg-cab-hoja">
    <img class="mrg-retrato" src="{{actor.img}}" onerror="this.onerror=null;this.src='icons/svg/mystery-man.svg'" data-edit="img" alt="{{actor.name}}" data-ayuda="Retrato||Pulsa para cambiar la imagen del personaje.">
    <div class="mrg-cab-datos">
      <input class="mrg-nombre" type="text" name="name" value="{{actor.name}}" placeholder="Nombre del monstruo" aria-label="Nombre">
      <div class="mrg-cab-chips">
        {{#if mr.raza}}
          {{#if mr.evolucion}}<button type="button" class="mrg-chipbtn mrg-chipbtn--evol" data-ir-libreto="raza" data-ayuda="Cambiar raza||Estás en modo evolución: pulsa para ver las razas del libreto y elegir otra."><i class="fa-solid fa-dragon"></i> {{mr.raza}} <i class="fa-solid fa-pen"></i></button>
          {{else}}<span class="mrg-chip mrg-chip--fijo" data-ayuda="Tu raza||La raza se elige al crear al monstruo y ya no cambia durante la partida (casi no afecta a las reglas: sirve para interpretar). Solo se cambia en modo evolución."><i class="fa-solid fa-dragon"></i> {{mr.raza}}</span>{{/if}}
        {{else}}<button type="button" class="mrg-chipbtn mrg-chipbtn--falta" data-ir-libreto="raza" data-ayuda="Elegir raza||Todavía no tienes raza: pulsa para verlas en el libreto y escoger una."><i class="fa-solid fa-dragon"></i> Elegir {{mr.etiquetas.raza}}</button>{{/if}}

        {{#if mr.vocacion}}
          {{#if mr.evolucion}}<button type="button" class="mrg-chipbtn mrg-chipbtn--evol" data-ir-libreto="voc" data-ayuda="Cambiar vocación||Estás en modo evolución: pulsa para ver las vocaciones del libreto y elegir otra."><i class="fa-solid fa-hat-wizard"></i> {{mr.vocacion}} <i class="fa-solid fa-pen"></i></button>
          {{else}}<span class="mrg-chip mrg-chip--fijo" data-ayuda="Tu vocación||Define tus capacidades. Se elige al crear al monstruo y no cambia durante la partida. Solo se cambia en modo evolución."><i class="fa-solid fa-hat-wizard"></i> {{mr.vocacion}}</span>{{/if}}
        {{else}}<button type="button" class="mrg-chipbtn mrg-chipbtn--falta" data-ir-libreto="voc" data-ayuda="Elegir vocación||Todavía no tienes vocación: pulsa para verlas en el libreto y escoger una."><i class="fa-solid fa-hat-wizard"></i> Elegir vocación</button>{{/if}}

        {{#each mr.impulsos}}<span class="mrg-chip mrg-chip--sangre" data-ayuda="Impulso oscuro: {{nombre}}||{{desc}} Satisfacerlo te da un corazón oscuro."><i class="fa-solid fa-fire"></i> {{nombre}}</span>{{/each}}
        {{#if mr.juerga}}<span class="mrg-chip mrg-chip--oro" data-ayuda="Juerga: {{mr.juerga.nombre}}||{{mr.juerga.desc}} Es cómo liberas estrés al gastar botín."><i class="fa-solid fa-beer-mug-empty"></i> {{mr.juerga.nombre}}</span>{{/if}}
        {{#if mr.evolucion}}<button type="button" class="mrg-chipbtn mrg-chipbtn--evol" data-ir-libreto="otros" data-ayuda="Impulso y juerga||Cambia tu impulso oscuro o tu juerga en el libreto."><i class="fa-solid fa-masks-theater"></i> Impulso y juerga</button>{{/if}}
      </div>
    </div>
  </header>

  {{#if mr.evolucion}}<p class="mrg-aviso-evol"><i class="fa-solid fa-dna"></i> <strong>Modo evolución.</strong> Puedes cambiar raza, vocación, impulso y juerga y aprender capacidades. Cuando acabes, pulsa de nuevo el icono <i class="fa-solid fa-dna"></i> de la barra para volver a bloquearlo.</p>{{/if}}

  {{#if mr.compacta}}
  {{!-- ============ FICHA COMPACTA (diseño propio) ============ --}}
  <div class="mrg-cuerpo mrg-compacto">
    <section class="mrg-c-vitales">
      <div class="mrg-c-fila">
        <span class="mrg-etiqueta" data-ayuda="Estrés||Se paga al resistir consecuencias y al usar capacidades. Al llenarse (6) te desatas.">Estrés</span>
        <div class="mrg-pips">{{#each mr.vitales.estres.pips}}<button type="button" class="mrg-pip" data-pip="system.stress.value" data-n="{{n}}" aria-pressed="{{on}}" aria-label="Estrés {{n}}"></button>{{/each}}</div>
        <b>{{mr.vitales.estres.valor}}/{{mr.vitales.estres.max}}</b>
      </div>
      <div class="mrg-c-fila">
        <span class="mrg-etiqueta" data-ayuda="Corazones oscuros||Dados extra: gasta uno para añadir +1d a una tirada.">♥</span>
        <div class="mrg-pips">{{#each mr.vitales.corazones.pips}}<button type="button" class="mrg-pip mrg-pip--corazon" data-pip="system.dark_hearts.value" data-n="{{n}}" aria-pressed="{{on}}" aria-label="Corazón oscuro {{n}}"></button>{{/each}}</div>
        {{#if mr.vitales.oro.visible}}<span class="mrg-etiqueta" data-ayuda="Oro||Tesoro propio: hasta 3.">Oro</span><div class="mrg-pips">{{#each mr.vitales.oro.pips}}<button type="button" class="mrg-pip mrg-pip--moneda" data-pip="system.gold.value" data-n="{{n}}" aria-pressed="{{on}}" aria-label="Oro {{n}}"></button>{{/each}}</div>{{/if}}
        <span class="mrg-etiqueta" data-ayuda="{{mr.etiquetas.suministro}}||Casillas tachadas = ya usadas. Quedan {{mr.vitales.suministro.quedan}} de {{mr.vitales.suministro.max}}.">Sum.</span>
        <div class="mrg-pips">{{#each mr.vitales.suministro.pips}}<button type="button" class="mrg-pip" data-pip="system.supply.value" data-n="{{n}}" aria-pressed="{{on}}" aria-label="Suministro {{n}}"></button>{{/each}}</div>
      </div>
      <div class="mrg-c-fila mrg-c-estados">
        {{#each mr.estados.conmocion}}<button type="button" class="mrg-chipbtn {{#if on}}mrg-sel{{/if}}" data-toggle="system.attributes.{{id}}.shocked" aria-pressed="{{on}}" data-ayuda="Conmoción en {{nombre}}||−1d en la siguiente tirada de {{nombre}}."><i class="fa-solid fa-bolt"></i> {{nombre}}</button>{{/each}}
        <button type="button" class="mrg-chipbtn {{#if mr.estados.reventado}}mrg-sel{{/if}}" data-toggle="system.bloodied" aria-pressed="{{mr.estados.reventado}}" data-ayuda="Reventado||Herida grave: otra herida seria te mata."><i class="fa-solid fa-droplet"></i> Reventado</button>
        <button type="button" class="mrg-chipbtn {{#if mr.estados.desatado}}mrg-sel{{/if}}" data-desatar="1" aria-pressed="{{mr.estados.desatado}}" data-ayuda="Desatado||Con el Estrés lleno actúas por impulso hasta descansar."><i class="fa-solid fa-skull"></i> Desatado</button>
      </div>
    </section>

    <section class="mrg-c-acciones">
      {{#each mr.atributos}}
      <article class="mrg-c-atrib {{#if shocked}}mrg-shock{{/if}}">
        <h4 class="mrg-titulo">{{nombre}}</h4>
        {{#each acciones}}
        <div class="mrg-c-accion">
          <button type="button" class="mrg-accion-tirar" data-tirar="{{id}}" data-ayuda="Tirar {{nombre}}||{{desc}} ({{dados}}d)"><span class="mrg-accion-nombre">{{nombre}}</span></button>
          <div class="mrg-valor">{{#each puntos}}<button type="button" class="mrg-pip mrg-pip--punto" data-pip="system.attributes.{{../atrib}}.skills.{{../id}}.value" data-n="{{n}}" aria-pressed="{{on}}" aria-label="{{../nombre}} {{n}}"></button>{{/each}}</div>
        </div>
        {{/each}}
      </article>
      {{/each}}
    </section>

    <div class="mrg-barra-rapida mrg-c-rapida">
      <button type="button" class="mrg-btn" data-tirada-tipo="resistencia" data-ayuda="Resistir||Tira una acción para reducir o evitar una consecuencia a cambio de Estrés."><i class="fa-solid fa-shield-halved"></i> Resistir</button>
      <button type="button" class="mrg-btn" data-tirada-tipo="fortuna" data-ayuda="Fortuna||Una tirada sin acción: eliges cuántos dados."><i class="fa-solid fa-dice"></i> Fortuna</button>
    </div>

    <details class="mrg-c-det" open>
      <summary><i class="fa-solid fa-skull"></i> Capacidades <span class="mrg-cuenta">{{mr.cuentaCaps}}</span></summary>
      {{#each mr.principales}}{{> "modules/mr-wicked-ones-es/templates/capacidad-compacta.hbs"}}{{/each}}
      {{#each mr.otras}}{{> "modules/mr-wicked-ones-es/templates/capacidad-compacta.hbs"}}{{/each}}
      {{#unless mr.cuentaCaps}}<p class="mrg-nota">Sin capacidades todavía.</p>{{/unless}}
    </details>
    <details class="mrg-c-det">
      <summary><i class="fa-solid fa-toolbox"></i> {{mr.etiquetas.equipo}} <span class="mrg-cuenta">{{mr.cuentaEquipo}}/4</span></summary>
      <div class="mrg-c-chips">{{#each mr.equipo}}<span class="mrg-chip" data-ayuda="{{nombre}}||{{desc}}">{{nombre}}</span>{{/each}}
      {{#each mr.suministros}}<button type="button" class="mrg-chipbtn" data-sacar="{{id}}" data-ayuda="Sacar {{nombre}}||Tacha una casilla de suministro y lo sacas del inventario."><i class="fa-solid fa-hand"></i> {{nombre}}</button>{{/each}}</div>
    </details>
  </div>

  {{else}}
  {{!-- ============ FICHA COMPLETA ============ --}}
  <section class="mrg-vitales" aria-label="Constantes vitales">
    <div class="mrg-vital mrg-vital--estres {{#if mr.vitales.estres.lleno}}mrg-lleno{{/if}}">
      <div class="mrg-vital-t"><span class="mrg-etiqueta" data-ayuda="Estrés||Se paga al resistir consecuencias (3, 2 o 1 según el resultado) y al usar capacidades. Al llegar a 6 te desatas. Pulsa una casilla para marcar hasta ahí; vuelve a pulsarla para bajar.">Estrés</span><b>{{mr.vitales.estres.valor}}<small>/{{mr.vitales.estres.max}}</small></b></div>
      <div class="mrg-pips" role="group" aria-label="Estrés">
        {{#each mr.vitales.estres.pips}}<button type="button" class="mrg-pip" data-pip="system.stress.value" data-n="{{n}}" aria-pressed="{{on}}" aria-label="Estrés {{n}}"></button>{{/each}}
      </div>
    </div>
    <div class="mrg-vital">
      <div class="mrg-vital-t"><span class="mrg-etiqueta" data-ayuda="Corazones oscuros||Dados acumulables (máximo 2). Gasta uno para añadir +1d a una tirada de acción o resistencia. Se ganan cumpliendo tu impulso oscuro o en una juerga.">Corazones</span><b>{{mr.vitales.corazones.valor}}<small>/{{mr.vitales.corazones.max}}</small></b></div>
      <div class="mrg-pips" role="group" aria-label="Corazones oscuros">
        {{#each mr.vitales.corazones.pips}}<button type="button" class="mrg-pip mrg-pip--corazon" data-pip="system.dark_hearts.value" data-n="{{n}}" aria-pressed="{{on}}" aria-label="Corazón oscuro {{n}}"></button>{{/each}}
      </div>
    </div>
    {{#if mr.vitales.oro.visible}}
    <div class="mrg-vital">
      <div class="mrg-vital-t"><span class="mrg-etiqueta" data-ayuda="Oro||Cuánto tesoro controlas tú (máximo 3, o los demás sospecharán). Gasta 1 para que alguien te ayude, pagar un precio o pagar a tus esbirros. Lo demás del botín va al tesoro de la mazmorra.">Oro</span><b>{{mr.vitales.oro.valor}}<small>/{{mr.vitales.oro.max}}</small></b></div>
      <div class="mrg-pips" role="group" aria-label="Oro">
        {{#each mr.vitales.oro.pips}}<button type="button" class="mrg-pip mrg-pip--moneda" data-pip="system.gold.value" data-n="{{n}}" aria-pressed="{{on}}" aria-label="Oro {{n}}"></button>{{/each}}
      </div>
      {{#if mr.tesoro}}<button type="button" class="mrg-tesoro" data-abrir-actor="{{mr.tesoro.id}}" data-ayuda="Tesoro de la mazmorra||El botín de las incursiones va al tesoro conjunto, y su tamaño es el nivel de la mazmorra (0 a 4). Tu oro es solo lo que controlas tú. Pulsa para abrir la hoja de la mazmorra."><i class="fa-solid fa-gem"></i> Tesoro · nivel {{mr.tesoro.nivel}}</button>{{/if}}
    </div>
    {{/if}}
    <div class="mrg-vital">
      <div class="mrg-vital-t"><span class="mrg-etiqueta" data-ayuda="{{mr.etiquetas.suministro}}||Cada casilla tachada es algo que ya has sacado del inventario. Si no quedan casillas, no llevas nada más. Se restablecen en la fase de recuperación.">{{mr.etiquetas.suministro}}</span><b>{{mr.vitales.suministro.quedan}}<small>/{{mr.vitales.suministro.max}}</small></b></div>
      <div class="mrg-pips" role="group" aria-label="{{mr.etiquetas.suministro}} usados">
        {{#each mr.vitales.suministro.pips}}<button type="button" class="mrg-pip" data-pip="system.supply.value" data-n="{{n}}" aria-pressed="{{on}}" aria-label="Casilla {{n}} usada"></button>{{/each}}
      </div>
    </div>
  </section>

  <section class="mrg-xp" aria-label="Experiencia">
    <div class="mrg-xp-b">
      <span class="mrg-etiqueta" data-ayuda="EXP malvada||Al completarla aprendes una capacidad nueva de tu vocación. Se gana al cumplir lo que marca tu hoja (impulso, hazañas malvadas).">EXP malvada <b>{{mr.vitales.malvada.valor}}/{{mr.vitales.malvada.max}}</b></span>
      <div class="mrg-seg mrg-seg--oro" role="group" aria-label="EXP malvada">{{#each mr.vitales.malvada.pips}}<button type="button" data-pip="system.wickedxp.value" data-n="{{n}}" aria-pressed="{{on}}" aria-label="EXP malvada {{n}}"></button>{{/each}}</div>
    </div>
    <div class="mrg-xp-b mrg-xp-b--osada">
      <span class="mrg-etiqueta" data-ayuda="EXP osada||Se gana al desatarte o quedar reventado interpretándolo (máximo 1 por sesión). Al completarla subes un punto de acción (máximo 3 por acción).">EXP osada <b>{{mr.vitales.osada.valor}}/{{mr.vitales.osada.max}}</b></span>
      <div class="mrg-seg" role="group" aria-label="EXP osada">{{#each mr.vitales.osada.pips}}<button type="button" data-pip="system.recklessxp.value" data-n="{{n}}" aria-pressed="{{on}}" aria-label="EXP osada {{n}}"></button>{{/each}}</div>
    </div>
  </section>

  {{!-- Heridas: solo el nivel y el texto; se gestionan en su ventana --}}
  <section class="mrg-tira" aria-label="Estado">
    <button type="button" class="mrg-tira-heridas nivel{{mr.heridas.nivel}}" data-heridas="1" data-ayuda="Heridas||Un monstruo sufre conmociones (leves), puede quedar reventado (grave) y morir. Pulsa para abrir la ventana donde se marcan y se apunta qué ha pasado.">
      <span class="mrg-gotas" aria-hidden="true">{{#each mr.heridas.gotas}}<i class="fa-solid fa-droplet g{{tam}} {{#if on}}on{{/if}}"></i>{{/each}}</span>
      <span class="mrg-tira-txt"><b>{{mr.heridas.nombre}}</b><small>{{mr.heridas.texto}}</small></span>
    </button>
    <button type="button" class="mrg-chipbtn mrg-desatado {{#if mr.estados.desatado}}mrg-sel{{/if}}" data-desatar="1" aria-pressed="{{mr.estados.desatado}}" data-ayuda="Desatado||Con el Estrés lleno actúas por impulso, tomas un corazón oscuro y no puedes usar capacidades ni resistir hasta descansar. Se marca solo al llenar el Estrés; también puedes pulsarlo."><i class="fa-solid fa-skull"></i> {{#if mr.estados.desatado}}Desatado{{else}}Bajo control{{/if}}</button>
  </section>

  <nav class="mrg-nav tabs" aria-label="Secciones de la hoja">
    <a class="item" data-tab="acciones"><i class="fa-solid fa-hand-fist"></i> Acciones</a>
    <a class="item" data-tab="capacidades"><i class="fa-solid fa-skull"></i> Capacidades <span class="mrg-cuenta">{{mr.cuentaCaps}}</span></a>
    <a class="item" data-tab="libreto"><i class="fa-solid fa-book-skull"></i> Libreto</a>
    <a class="item" data-tab="equipo"><i class="fa-solid fa-toolbox"></i> {{mr.etiquetas.equipo}} <span class="mrg-cuenta">{{mr.cuentaEquipo}}</span></a>
    <a class="item" data-tab="guarida"><i class="fa-solid fa-dungeon"></i> {{mr.etiquetas.guarida}}</a>
    <a class="item" data-tab="notas"><i class="fa-solid fa-feather"></i> Notas</a>
  </nav>

  <div class="mrg-cuerpo">

    {{!-- ACCIONES --}}
    <section class="tab mrg-panel" data-tab="acciones">
      <div class="mrg-barra-rapida">
        <span class="mrg-nota">Pulsa el nombre de una acción para tirar. <strong>●</strong> son tus puntos (se editan pulsando). Las acciones sin puntos muestran su <strong>práctica ◇</strong>: tres tiradas y suben a 1.</span>
        <button type="button" class="mrg-btn" data-tirada-tipo="resistencia" data-ayuda="Resistir||Elige una acción y tira para reducir o evitar una consecuencia a cambio de Estrés (3, 2 o 1; el crítico despeja 1)."><i class="fa-solid fa-shield-halved"></i> Resistir</button>
        <button type="button" class="mrg-btn" data-tirada-tipo="fortuna" data-ayuda="Fortuna||Una tirada sin acción ni posición: tú eliges cuántos dados."><i class="fa-solid fa-dice"></i> Fortuna</button>
      </div>
      <div class="mrg-atributos">
        {{#each mr.atributos}}
        <article class="mrg-atributo {{#if shocked}}mrg-shock{{/if}}">
          <header>
            <h3 class="mrg-titulo">{{nombre}}</h3>
            {{#if shocked}}<span class="mrg-chip mrg-chip--sangre" data-ayuda="Conmoción||−1d en la siguiente tirada de {{nombre}}. Se quita en el panel de Estados."><i class="fa-solid fa-bolt"></i> −1d</span>{{/if}}
          </header>
          <p class="mrg-nota mrg-atr-desc">{{desc}}</p>
          {{#each acciones}}
          <div class="mrg-accion-fila">
            <button type="button" class="mrg-accion-tirar" data-tirar="{{id}}" data-ayuda="Tirar {{nombre}}||{{desc}}. Tiras {{dados}}d{{#unless dados}} (se tiran 2d y cuenta el menor){{/unless}}."><span class="mrg-accion-nombre">{{nombre}}</span><span class="mrg-accion-desc">{{desc}}</span></button>
            <div class="mrg-valor" role="group" aria-label="Puntos de {{nombre}}" data-ayuda="Puntos de {{nombre}}||Cada punto es un dado al tirar esta acción. Se reparten 3, 2, 2, 1 y 1 al crear el personaje; pulsa para cambiarlos.">
              {{#each puntos}}<button type="button" class="mrg-pip mrg-pip--punto" data-pip="system.attributes.{{../atrib}}.skills.{{../id}}.value" data-n="{{n}}" aria-pressed="{{on}}" aria-label="{{../nombre}} {{n}}"></button>{{/each}}
            </div>
            {{#if sinPuntos}}<div class="mrg-practica" role="group" aria-label="Práctica de {{nombre}}" data-ayuda="Práctica||Esta acción no tiene puntos: cada tirada con ella (aunque sea de resistencia) marca una práctica y a la tercera sube a 1 punto.">
              {{#each marcas}}<button type="button" class="mrg-marca {{#if on}}on{{/if}}" data-practica="1" data-atrib="{{../atrib}}" data-accion="{{../id}}" data-n="{{n}}" aria-label="Práctica {{n}}"></button>{{/each}}
            </div>{{/if}}
          </div>
          {{/each}}
        </article>
        {{/each}}
      </div>
    </section>

    {{!-- CAPACIDADES --}}
    <section class="tab mrg-panel" data-tab="capacidades">
      <details class="mrg-guia">
        <summary><i class="fa-solid fa-circle-info"></i> ¿Cómo se usan las capacidades?</summary>
        <ul>
          <li><span class="mrg-chip mrg-uso mrg-uso--pasiva">Pasiva</span> Siempre activa: no hay que hacer nada.</li>
          <li><span class="mrg-chip mrg-uso mrg-uso--estres">Cuesta Estrés</span> Pulsa <em>Usar</em> y sufres 1 de Estrés. No lleva tirada propia: hace automático lo que una acción ya podría lograr, o te deja <em>intentar</em> con una tirada algo que sin ella no podrías.</li>
          <li><span class="mrg-chip mrg-uso mrg-uso--marca">Se marca</span> Tiene casillas: se marca al gastar un uso y se limpia al descansar. No cuesta Estrés.</li>
          <li><span class="mrg-chip mrg-uso mrg-uso--dados">Da dados</span> Suma dados cuando se cumple su condición: añádelos al tirar (± dados en el lanzador).</li>
          <li><span class="mrg-chip mrg-uso mrg-uso--resultado">Tras un resultado</span> Se activa sola cuando la tirada sale como dice el texto.</li>
        </ul>
      </details>
      <div class="mrg-barra-rapida">
        {{#if mr.puedeAprender}}
        <span class="mrg-nota">{{#if mr.xpLleno}}<strong>¡Tu EXP malvada está completa!</strong> Puedes aprender una capacidad nueva.{{else}}Puedes elegir capacidades de tu libreto.{{/if}}</span>
        <button type="button" class="mrg-btn mrg-btn--sangre" data-ir-libreto="voc" data-ayuda="Aprender||Abre el libreto de tu vocación para elegir una capacidad."><i class="fa-solid fa-graduation-cap"></i> Aprender una capacidad</button>
        {{else}}
        <span class="mrg-nota"><i class="fa-solid fa-lock"></i> Aprenderás otra capacidad cuando completes la EXP malvada ({{mr.vitales.malvada.valor}}/{{mr.vitales.malvada.max}}).</span>
        {{/if}}
      </div>
      {{#each mr.principales}}{{> "modules/mr-wicked-ones-es/templates/capacidad.hbs"}}{{/each}}
      {{#each mr.otras}}{{> "modules/mr-wicked-ones-es/templates/capacidad.hbs"}}{{/each}}
      {{#unless mr.cuentaCaps}}<p class="mrg-vacio">Aún no tienes capacidades. Ábrete el <strong>Libreto</strong> y elige las de tu vocación.</p>{{/unless}}
    </section>

    {{!-- LIBRETO --}}
    <section class="tab mrg-panel" data-tab="libreto" data-pestana-libreto>
      {{{mr.libretoHTML}}}
    </section>

    {{!-- EQUIPO --}}
    <section class="tab mrg-panel" data-tab="equipo">
      <div class="mrg-reglas-equipo">
        <span class="mrg-chip {{#if mr.equipoExcedido}}mrg-chip--sangre{{else}}{{#if mr.equipoLleno}}mrg-chip--oro{{/if}}{{/if}}" data-ayuda="{{mr.etiquetas.equipo}}||Lo que siempre llevas encima: hasta cuatro objetos. Entre todos te dan una única defensa."><i class="fa-solid fa-toolbox"></i> {{mr.etiquetas.equipo}} {{mr.cuentaEquipo}}/4{{#if mr.equipoExcedido}} · ¡te pasas!{{/if}}</span>
        <span class="mrg-chip" data-ayuda="{{mr.etiquetas.suministro}}||Lo que guardas en el cinturón o la mochila. Al sacar algo se tacha una casilla (arriba); sin casillas no llevas nada más. Se restablecen al recuperarte."><i class="fa-solid fa-sack-xmark"></i> {{mr.etiquetas.suministro}} quedan {{mr.vitales.suministro.quedan}}/{{mr.vitales.suministro.max}}</span>
        {{#each mr.defensas}}<label class="mrg-defensa" data-ayuda="Defensa: {{nombre}}||Tacha la casilla para usarla: evitas por completo una consecuencia de ese tipo, sin generar estrés. Se regenera al recuperarte."><input type="checkbox" data-item-check="{{id}}" data-campo="checked" {{#if on}}checked{{/if}}><span><i class="fa-solid fa-shield"></i> {{nombre}}</span><button type="button" class="mrg-mini" data-borrar="{{id}}" aria-label="Quitar {{nombre}}"><i class="fa-solid fa-xmark"></i></button></label>{{else}}<button type="button" class="mrg-chipbtn" data-selector="defense" data-ayuda="Defensa||Tu equipo te da una defensa contra un tipo de problema (captura, detección, heridas, magia…)."><i class="fa-solid fa-shield"></i> Elegir defensa</button>{{/each}}
        <button type="button" class="mrg-btn mrg-btn--sangre mrg-anadir" data-selector="gearsupply" data-ayuda="Añadir objeto||Abre el catálogo. Los mejunjes, pociones y cosas de uso limitado van solos a suministros; lo demás, a equipo."><i class="fa-solid fa-plus"></i> Añadir objeto</button>
      </div>
      <div class="mrg-lista mrg-lista--eq">
        {{#each mr.equipo}}
        <article class="mrg-objeto" data-ayuda="{{nombre}}||{{desc}}"><header><h5><button type="button" class="mrg-enlace" data-abrir="{{id}}">{{nombre}}</button></h5>
          {{#if calidad}}<span class="mrg-chip {{calidadClase}}">{{calidad}}</span>{{/if}}<span class="mrg-chip">Equipo</span>
          <button type="button" class="mrg-mini" data-borrar="{{id}}" aria-label="Quitar {{nombre}}"><i class="fa-solid fa-xmark"></i></button></header>
          {{#if desc}}<p>{{desc}}</p>{{/if}}</article>
        {{/each}}
        {{#each mr.suministros}}
        <article class="mrg-objeto" data-ayuda="{{nombre}}||{{desc}}"><header><h5><button type="button" class="mrg-enlace" data-abrir="{{id}}">{{nombre}}</button></h5>
          {{#if calidad}}<span class="mrg-chip {{calidadClase}}">{{calidad}}</span>{{/if}}
          <button type="button" class="mrg-btn" data-sacar="{{id}}" data-ayuda="Sacar del inventario||Tacha una casilla de suministro y lo muestras en el chat. Si no te quedan casillas, no lo llevas."><i class="fa-solid fa-hand"></i> Sacar</button>
          <button type="button" class="mrg-mini" data-borrar="{{id}}" aria-label="Quitar {{nombre}}"><i class="fa-solid fa-xmark"></i></button></header>
          {{#if desc}}<p>{{desc}}</p>{{/if}}</article>
        {{/each}}
        {{#unless mr.equipo.length}}{{#unless mr.suministros.length}}<p class="mrg-nota">Sin objetos todavía. Pulsa «Añadir objeto» (en el libreto tienes ideas de tu vocación).</p>{{/unless}}{{/unless}}
      </div>
    </section>

    {{!-- GUARIDA / CONQUISTA --}}
    <section class="tab mrg-panel" data-tab="guarida">
      <div class="mrg-interruptor-fila">
        <button type="button" class="mrg-interruptor {{#if mr.descansoUsado}}mrg-on{{/if}}" data-toggle="system.downtime_action_used" aria-pressed="{{mr.descansoUsado}}" data-ayuda="{{mr.etiquetas.descanso}}||Una por fase de descanso: úsala para fabricar, investigar, recuperarte o lo que permita tu libreto."><i class="fa-solid fa-bed"></i> <span><strong>{{mr.etiquetas.descanso}}</strong><small>{{#if mr.descansoUsado}}Ya la has usado{{else}}Disponible{{/if}}</small></span></button>
      </div>
      {{#if mr.despertado}}
      <h4 class="mrg-seccion">Movimientos de conquista <small>un movimiento por fase de conquista</small></h4>
      <div class="mrg-lista">
        {{#each mr.movimientos}}<article class="mrg-objeto"><header><h5><button type="button" class="mrg-enlace" data-abrir="{{id}}">{{nombre}}</button></h5></header>{{#each bloques}}{{#if texto}}<p>{{texto}}</p>{{/if}}{{/each}}</article>{{else}}<p class="mrg-nota">Ninguna de tus capacidades añade movimientos de conquista.</p>{{/each}}
      </div>
      {{else}}
      <h4 class="mrg-seccion">Proyectos <small>relojes de varias sesiones</small> <button type="button" class="mrg-btn mrg-btn--suave" data-selector="project"><i class="fa-solid fa-plus"></i></button></h4>
      <div class="mrg-lista">
        {{#each mr.proyectos}}
        <article class="mrg-objeto"><header><h5><button type="button" class="mrg-enlace" data-abrir="{{id}}">{{nombre}}</button></h5><b>{{valor}}/{{max}}</b>
          <button type="button" class="mrg-mini" data-borrar="{{id}}" aria-label="Quitar {{nombre}}"><i class="fa-solid fa-trash"></i></button></header>
          <div class="mrg-pips">{{#each pips}}<button type="button" class="mrg-pip" data-item-pip="{{../id}}" data-campo="system.clock_progress" data-n="{{n}}" aria-pressed="{{on}}" aria-label="Segmento {{n}}"></button>{{/each}}</div>
          {{#if desc}}<p>{{desc}}</p>{{/if}}</article>
        {{else}}<p class="mrg-nota">Sin proyectos.</p>{{/each}}
      </div>
      <h4 class="mrg-seccion">Labores <small>lo que haces para la mazmorra</small> <button type="button" class="mrg-btn mrg-btn--suave" data-selector="duty"><i class="fa-solid fa-plus"></i></button></h4>
      <div class="mrg-lista">
        {{#each mr.labores}}
        <article class="mrg-objeto"><header><h5><button type="button" class="mrg-enlace" data-abrir="{{id}}">{{nombre}}</button></h5>{{#if tipo}}<span class="mrg-chip">{{tipo}}</span>{{/if}}{{#if nivel}}<span class="mrg-chip mrg-chip--oro">Nivel {{nivel}}</span>{{/if}}
          <button type="button" class="mrg-mini" data-borrar="{{id}}" aria-label="Quitar {{nombre}}"><i class="fa-solid fa-trash"></i></button></header>
          {{#if desc}}<p>{{desc}}</p>{{/if}}</article>
        {{else}}<p class="mrg-nota">Sin labores.</p>{{/each}}
      </div>
      {{/if}}
    </section>

    {{!-- NOTAS --}}
    <section class="tab mrg-panel" data-tab="notas">
      <div class="mrg-campos">
        <label class="mrg-campo"><span class="mrg-etiqueta">Aspecto</span><input type="text" name="system.look" value="{{system.look}}"></label>
        <label class="mrg-campo"><span class="mrg-etiqueta">Amigo vil</span><input type="text" name="system.vilefriend" value="{{system.vilefriend}}" placeholder="Un monstruo de la región amistoso contigo"></label>
        <label class="mrg-campo"><span class="mrg-etiqueta">Panda de esbirros</span>
          <span class="mrg-fila"><select data-panda><option value="">— ninguna —</option>{{#each mr.pandas}}<option value="{{id}}" {{#if sel}}selected{{/if}}>{{nombre}}</option>{{/each}}</select>
          <button type="button" class="mrg-btn" data-abrir-panda>Abrir</button></span></label>
      </div>
      <div class="mrg-editor"><span class="mrg-etiqueta">Notas</span>{{editor notes target="system.description" button=true owner=owner editable=editable}}</div>
    </section>

  </div>
  {{/if}}
</form>
